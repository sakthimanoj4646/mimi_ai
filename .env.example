# ==============================================================================
# MIMI AI — YOUR CREATIVE VIDEO STUDIO
# Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Security & Authentication
JWT_SECRET=mimi_ai_jwt_secret_change_in_production_99881122
JWT_EXPIRES_IN=7d

# File Storage Locations (Internal Private Paths)
DATABASE_PATH=./data/mimi_studio.db
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
MAX_UPLOAD_SIZE_MB=100

# AI Services Integration
# Google Gemini API for Mimi Multilingual Chat & Structured Plan Generation (Tamil/Tanglish/English)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Video Generation Services (Runway, Luma, Replicate, or OpenAI Sora)
VIDEO_GEN_PROVIDER=mock # Options: replicate, runway, luma, mock
REPLICATE_API_TOKEN=your_replicate_api_token_here
RUNWAY_API_KEY=your_runway_api_key_here
LUMA_API_KEY=your_luma_api_key_here

# Development / Mock Mode
# When true, the application provides high-fidelity deterministic fallback responses with clear UI badges
MOCK_MODE=true
